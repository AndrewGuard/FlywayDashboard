# Flyway Dashboard Server Configuration

# Set to true for demo mode with mock data
# Set to false or leave unset for production mode with real JDBC connections
DEMO_MODE=false

# Server Port (Backend API)
# The port where the Express server will listen for API requests
# Default: 3001
# Note: If you change this, update ALLOWED_ORIGINS and client config.json accordingly
PORT=3001

# Allowed Origins for CORS (comma-separated)
# Must include the URL where your React client is running
# Examples:
#   - Development: http://localhost:3000 (or your custom client PORT)
#   - Production: https://flyway-dashboard.yourcompany.com,https://dashboard.example.com
#   - Allow all (not recommended for production): *
# Note: If you change client PORT, update this accordingly (e.g., http://localhost:3002)
ALLOWED_ORIGINS=http://localhost:3000

# JDBC Connection Encryption Key (REQUIRED for security)
# Generate a new key by running: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret and never commit it to version control
# In production, use Azure Key Vault, AWS Secrets Manager, or environment variables
JDBC_ENCRYPTION_KEY=your_64_character_hex_key_here

# PostgreSQL Credentials
# Used when connecting to PostgreSQL databases via JDBC
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# SQL Server Credentials
# Used when connecting to SQL Server databases via JDBC
MSSQL_USER=your_mssql_user
MSSQL_PASSWORD=your_mssql_password

# Oracle Credentials (when you add Oracle support)
ORACLE_USER=flyway
ORACLE_PASSWORD=your_oracle_password

# MySQL Credentials (when you add MySQL support)
MYSQL_USER=flyway
MYSQL_PASSWORD=your_mysql_password

# Security Notes:
# - Never commit your actual .env file to version control
# - Use environment variables in production (Azure App Service, AWS, etc.)
# - See SECURITY.md for credential management best practices
# - Consider using secret management services (Azure Key Vault, AWS Secrets Manager)
