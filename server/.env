# Set to true for demo mode with mock data
# Set to false or leave unset for production mode with real JDBC connections
DEMO_MODE=false

PORT=3001

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# SQL Server Credentials
MSSQL_USER=Andrew
MSSQL_PASSWORD=foo

# Oracle Credentials (when you add Oracle support)
ORACLE_USER=flyway
ORACLE_PASSWORD=your_password_here

# MySQL Credentials (when you add MySQL support)
MYSQL_USER=flyway
MYSQL_PASSWORD=your_password_here