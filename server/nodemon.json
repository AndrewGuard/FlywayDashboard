{
  "watch": [
    "index.js",
    "routes/**/*.js",
    "db/**/*.js",
    "flywayHistory.js",
    "jdbc-connections.json",
    ".env"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules/**",
    "db/flyway-dashboard.db",
    "db/*.db-*"
  ],
  "delay": "500",
  "verbose": true,
  "env": {
    "NODE_ENV": "development"
  }
}
