# Package Flyway Dashboard Server for Distribution
# Creates a ZIP file with standalone EXE and all necessary files

param(
    [string]$Version = "1.0.0"
)

$ErrorActionPreference = "Stop"

Write-Host "========================================" -ForegroundColor Cyan
Write-Host "  Flyway Dashboard - Package Builder" -ForegroundColor Cyan
Write-Host "  Version: $Version" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
Write-Host ""

# Check if pkg is installed
Write-Host "Checking for pkg..." -ForegroundColor Yellow
try {
    pkg --version | Out-Null
    Write-Host "✓ pkg is installed" -ForegroundColor Green
    Write-Host ""
} catch {
    Write-Host "✗ pkg is not installed!" -ForegroundColor Red
    Write-Host "Install with: npm install -g pkg" -ForegroundColor Yellow
    Write-Host ""
    exit 1
}

# Create dist directory
$distDir = "..\dist"
$execDir = "$distDir\executables"
$packageDir = "$distDir\flyway-dashboard-server-$Version"

Write-Host "Creating directories..." -ForegroundColor Yellow
New-Item -ItemType Directory -Force -Path $distDir | Out-Null
New-Item -ItemType Directory -Force -Path $execDir | Out-Null
New-Item -ItemType Directory -Force -Path $packageDir | Out-Null
Write-Host "✓ Directories created" -ForegroundColor Green
Write-Host ""

# Build executable
Write-Host "Building Windows executable..." -ForegroundColor Yellow
Write-Host "This may take a few minutes..." -ForegroundColor Gray
Write-Host ""

try {
    pkg . --targets node18-win-x64 --output "$execDir\server.exe"
    Write-Host "✓ Executable built: $execDir\server.exe" -ForegroundColor Green
    Write-Host ""
} catch {
    Write-Host "✗ Build failed: $_" -ForegroundColor Red
    exit 1
}

# Copy files to package directory
Write-Host "Packaging distribution files..." -ForegroundColor Yellow

# Copy executable
Copy-Item "$execDir\server.exe" -Destination "$packageDir\server.exe"
Write-Host "  ✓ server.exe" -ForegroundColor Gray

# Copy configuration templates
Copy-Item ".env.example" -Destination "$packageDir\.env.example"
Write-Host "  ✓ .env.example" -ForegroundColor Gray

Copy-Item "jdbc-connections.json.template" -Destination "$packageDir\jdbc-connections.json"
Write-Host "  ✓ jdbc-connections.json" -ForegroundColor Gray

# Copy README
Copy-Item "DISTRIBUTION_README.txt" -Destination "$packageDir\README.txt"
Write-Host "  ✓ README.txt" -ForegroundColor Gray

# Copy QUICKSTART guide
Copy-Item "QUICKSTART.md" -Destination "$packageDir\QUICKSTART.md"
Write-Host "  ✓ QUICKSTART.md" -ForegroundColor Gray

# Create db directory
New-Item -ItemType Directory -Force -Path "$packageDir\db" | Out-Null
Write-Host '  ✓ db\ (folder)' -ForegroundColor Gray

Write-Host "" 
Write-Host "✓ Package assembled" -ForegroundColor Green
Write-Host ""

# Create ZIP archive
Write-Host "Creating ZIP archive..." -ForegroundColor Yellow
$zipPath = "$distDir\flyway-dashboard-server-$Version.zip"

if (Test-Path $zipPath) {
    Remove-Item $zipPath -Force
}

Compress-Archive -Path "$packageDir\*" -DestinationPath $zipPath -CompressionLevel Optimal
Write-Host "✓ ZIP created: $zipPath" -ForegroundColor Green
Write-Host ""

# Show package contents
Write-Host "Package contents:" -ForegroundColor Cyan
Get-ChildItem $packageDir -Recurse | ForEach-Object {
    $relativePath = $_.FullName.Substring($packageDir.Length)
    Write-Host "  $relativePath" -ForegroundColor Gray
}

# Show file size
$zipSize = (Get-Item $zipPath).Length / 1MB
Write-Host ""
Write-Host "Package size: $([math]::Round($zipSize, 2)) MB" -ForegroundColor Yellow

# Final summary
Write-Host ""
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "  Build Complete! 🚀" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Cyan
Write-Host ""

Write-Host "Distribution package:" -ForegroundColor Cyan
Write-Host "  Location: $zipPath" -ForegroundColor White
Write-Host "  Size: $([math]::Round($zipSize, 2)) MB" -ForegroundColor White
Write-Host ""

Write-Host "Contents:" -ForegroundColor Cyan
Write-Host "  - server.exe (standalone executable)" -ForegroundColor White
Write-Host "  - .env.example (configuration template)" -ForegroundColor White
Write-Host "  - jdbc-connections.json (database config)" -ForegroundColor White
Write-Host "  - README.txt (user guide)" -ForegroundColor White
Write-Host "  - QUICKSTART.md (setup guide)" -ForegroundColor White
Write-Host '  - db\ (auto-created SQLite folder)' -ForegroundColor White
Write-Host ""

Write-Host "Next steps:" -ForegroundColor Cyan
Write-Host "  1. Test the package on a clean machine" -ForegroundColor White
Write-Host "  2. Distribute $zipPath to users" -ForegroundColor White
Write-Host "  3. Users extract and run server.exe" -ForegroundColor White
Write-Host ""

Write-Host "Testing the package:" -ForegroundColor Yellow
Write-Host '  cd $packageDir' -ForegroundColor Gray
Write-Host '  .\server.exe' -ForegroundColor Gray
Write-Host ""
