    "dev": "nodemon index.js",
    "setup": "node setup-wizard.js",
    "diagnostics": "node diagnostics.js",
    "test-connections": "node -e \"require('./flywayHistory').testConnections()\"",
    "build-exe": "node build-exe.js",
