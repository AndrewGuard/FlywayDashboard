# Flyway Dashboard Client Configuration

# React Development Server Port
# The port where the React development server will run
# Default: 3000
PORT=3000

# API Server URL for Development
# Points to the backend server (must match server PORT in server/.env)
# This is used by the proxy configuration during development
# Default: http://localhost:3001
REACT_APP_API_URL=http://localhost:3001

# For production deployment:
# 1. Ensure DEMO_MODE is false or unset
# 2. Configure JDBC connections in your database (see JDBC_CONNECTION format below)
# 3. Flyway schema history tables must exist in your databases
# 4. The app will read from flyway_schema_history tables via JDBC

# Example JDBC Connection Format:
# Store in the 'jdbc_connections' table in SQLite:
# {
#   "server": "your-db-server",
#   "database": "your-db-name", 
#   "username": "your-username",
#   "password": "your-password",
#   "port": 1433,
#   "type": "mssql"  // or "postgres", "mysql", "oracle"
# }
