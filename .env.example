# Flyway Dashboard Configuration

# DEMO_MODE: Set to 'true' for demo/development with mock data and auto-seeding
# Leave unset or set to 'false' for production deployment with real JDBC connections
# Default: false (production mode)
DEMO_MODE=false

# Server Configuration
PORT=3001

# For production deployment:
# 1. Ensure DEMO_MODE is false or unset
# 2. Configure JDBC connections in your database (see JDBC_CONNECTION format below)
# 3. Flyway schema history tables must exist in your databases
# 4. The app will read from flyway_schema_history tables via JDBC

# Example JDBC Connection Format:
# Store in the 'jdbc_connections' table in SQLite:
# {
#   "server": "your-db-server",
#   "database": "your-db-name", 
#   "username": "your-username",
#   "password": "your-password",
#   "port": 1433,
#   "type": "mssql"  // or "postgres", "mysql", "oracle"
# }
